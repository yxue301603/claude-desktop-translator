{
  "name": "claude-desktop-translator",
  "version": "1.0.1",
  "description": "Claude Desktop extension: English-only API/offline submission and translated output timeline",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claude-translator": "bin/translator.mjs"
  },
  "scripts": {
    "start": "node bin/offline.mjs launch",
    "setup": "node bin/offline.mjs setup",
    "models": "node scripts/download-models.mjs",
    "test": "node --test",
    "doctor": "node scripts/offline-smoke.mjs",
    "accuracy": "node scripts/accuracy-check.mjs",
    "status": "node bin/offline.mjs status",
    "stop": "node bin/offline.mjs stop",
    "extension": "node bin/extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "verify:extension": "node scripts/verify-extension.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}

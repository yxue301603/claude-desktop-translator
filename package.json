{
  "name": "claude-desktop-translator",
  "version": "0.3.0",
  "description": "Offline Chinese/English companion for the signed-in Claude Desktop app on Windows",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "claude-translator": "bin/translator.mjs"
  },
  "scripts": {
    "start": "node bin/offline.mjs launch",
    "setup": "node bin/offline.mjs setup",
    "models": "node scripts/download-models.mjs",
    "test": "node --test",
    "doctor": "node scripts/offline-smoke.mjs",
    "accuracy": "node scripts/accuracy-check.mjs",
    "status": "node bin/offline.mjs status",
    "stop": "node bin/offline.mjs stop"
  },
  "license": "MIT"
}
